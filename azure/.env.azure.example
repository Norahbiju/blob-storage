# Copy to azure/.env.azure and adjust before running ./azure/deploy.sh.
# Run `az login` and `az account set --subscription "<SUBSCRIPTION_ID>"` first.

PROJECT_PREFIX=insclaims
LOCATION=eastus
APP_SERVICE_LOCATION=westus2
ENVIRONMENT=prod

# Must be globally unique. Leave blank to let deploy.sh generate names.
APP_NAME=
APP_SERVICE_PLAN_NAME=
RESOURCE_GROUP=
STORAGE_ACCOUNT_NAME=
COSMOS_ACCOUNT_NAME=
KEY_VAULT_NAME=
APP_INSIGHTS_NAME=
LOG_ANALYTICS_NAME=
APP_GATEWAY_NAME=
WAF_POLICY_NAME=
PUBLIC_IP_NAME=
VNET_NAME=

# App credentials used by the current demo login system.
# Replace before any real deployment.
DEMO_USER_PASSWORD=replace-with-user-demo-password
DEMO_ADMIN_PASSWORD=replace-with-admin-demo-password
SESSION_SECRET=replace-with-long-random-session-secret

# App data settings.
COSMOS_DB_DATABASE_NAME=insurance-claims
COSMOS_DB_CONTAINER_NAME=claims
AZURE_STORAGE_CONTAINER_NAME=insurance-documents

# Network ranges.
VNET_CIDR=10.42.0.0/16
APPGW_SUBNET_CIDR=10.42.1.0/24
APP_SERVICE_INTEGRATION_SUBNET_CIDR=10.42.2.0/24
PRIVATE_ENDPOINT_SUBNET_CIDR=10.42.3.0/24

# Sizing.
APP_SERVICE_SKU=P1V3
APP_GATEWAY_SKU=WAF_v2
APP_GATEWAY_CAPACITY=1
COSMOS_THROUGHPUT=400

# Storage redundancy. RAGZRS gives zone redundancy in the primary region plus read-access geo-replication.
STORAGE_SKU=Standard_RAGZRS

# Set to true only if you have an HTTPS certificate ready and extend the script.
# The generated script uses HTTP on Application Gateway for initial validation.
ENABLE_APPGW_HTTPS=false
ENABLE_APP_SERVICE_RESTRICTION=false
