PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret

# Leave blank for local filesystem storage during development.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=insurance-documents
AZURE_STORAGE_STAGING_CONTAINER_NAME=insurance-documents-staging

# Leave blank for local JSON metadata storage during development.
COSMOS_DB_ENDPOINT=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE_NAME=insurance-claims
COSMOS_DB_CONTAINER_NAME=claims

# Demo credentials. Replace before production use.
DEMO_USER_PASSWORD=user123
DEMO_ADMIN_PASSWORD=admin123
DEMO_USER_EMAIL=user@example.com
DEMO_ADMIN_EMAIL=admin@example.com

# Azure Function / document validation settings.
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
SERVICE_BUS_CONNECTION=
SERVICE_BUS_MAIL_QUEUE_NAME=claim-validation-mails

# Mail Function SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=claims@example.com
